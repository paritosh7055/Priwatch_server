# PriceWatch — Blocked-stores fork (Zepto, BigBasket, Tata Neu)
# ScraperAPI / SCRAPE_PROXY_URL are OPTIONAL — leave unset to use normal IP.
# Copy values into Railway Variables (do not commit secrets).

# Required — Railway Postgres plugin reference, e.g. ${{Postgres.DATABASE_URL}}
DATABASE_URL=
# Do NOT set DIRECT_URL

NODE_ENV=production
# Your frontend public URL (after Generate Domain)
CORS_ORIGIN=https://your-blocked-frontend.up.railway.app

JWT_SECRET=
JWT_EXPIRES_IN=7d

OWNER_EMAIL=admin@pricewatch.app
OWNER_PASSWORD=
OWNER_NAME=PriceWatch Owner

# Recommended — Railway Redis plugin, e.g. ${{Redis.REDIS_URL}}
# Without Redis the API still boots (in-process scheduler fallback).
REDIS_URL=

ENABLE_WORKER=true
SCRAPER_MODE=live
WORKER_CONCURRENCY=1

# Optional — leave empty if you have no ScraperAPI credits
#SCRAPERAPI_KEY=
#SCRAPE_PROXY_URL=
