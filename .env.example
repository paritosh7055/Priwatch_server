# PriceWatch — Blocked-stores fork (Meesho, Zepto, BigBasket, Tata Neu)
# server env template.
# These 4 stores were edge/WAF-blocked from the Hetzner (Finland) VPS IP that
# hosts the Flipkart/Amazon/Others forks — this fork exists to deploy them
# somewhere with a different egress IP (e.g. Railway) to see if that alone
# resolves the block, before spending money on a residential proxy.
# Copy to .env locally, or set these in Railway's dashboard.
# Never commit real secrets.

# This fork's OWN Postgres database. On Railway, add a Postgres plugin and
# reference it as DATABASE_URL=${{Postgres.DATABASE_URL}} (Railway fills
# this in automatically — you don't need to paste a real connection string).
# Do NOT set DIRECT_URL — this fork's schema only uses DATABASE_URL.
DATABASE_URL=

PORT=4003
NODE_ENV=production
# Must match this fork's frontend deployment URL (Railway/Vercel/etc.).
CORS_ORIGIN=https://blocked-pricewatch.example.com

# Use a long random string, DIFFERENT from every other fork.
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Seed owner (created by `npm run db:seed`)
OWNER_EMAIL=admin@pricewatch.app
OWNER_PASSWORD=
OWNER_NAME=PriceWatch Owner

# This fork's OWN Redis instance. On Railway, add a Redis plugin and
# reference it as REDIS_URL=${{Redis.REDIS_URL}}.
REDIS_URL=
ENABLE_WORKER=true
SCRAPER_MODE=live
WORKER_CONCURRENCY=1

# Optional — only needed if these stores still get blocked on Railway too and
# you want ScraperAPI as a JS-render/proxy fallback. Get a fresh key or top
# up credits first — the shared key used by the other forks ran out on
# 2026-08-04.
#SCRAPERAPI_KEY=

# Optional — routes scrapes through a proxy (undici + Playwright, already
# wired up in fetchPage.ts) to dodge Akamai/CloudFront geo-blocks. Only set
# this if the stores are STILL blocked after deploying to Railway — if
# Railway's IP isn't on the same blocklist, you may not need this at all.
#SCRAPE_PROXY_URL=
